{
  "buildCommand": "npm run build",
  "outputDirectory": "www",
  "cleanUrls": true,
  "rewrites": [
    {
      "has": [
        {
          "type": "host",
          "value": "admin.kev-in.site"
        }
      ],
      "source": "/(.*)",
      "destination": "/admin/$1"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/$1"
    }
  ]
}
